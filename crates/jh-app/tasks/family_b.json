{
  "name": "family-b",
  "source": "crates/jh-app/tasks/family_b.json",
  "notes": "任务族 B：现有问题无法区分的成对场景（研究目标 §9.3）。3 对 × 每对 2 个未见变体，每对一 B1、一 B2；B1 的关键证据在初始快照里给全（输入获取过程固定），B2 的关键证据不在判断可见的材料里、只能靠计费的观察动作取得。隐藏真值只进判分与独立验收，不进判断请求。问题定义里写清「未列入候选集」（other）的判据——M1 的 A1 教训。",
  "questions": [
    {
      "id": "b_pair_cause_p1",
      "version": 1,
      "reads": [
        "app.log"
      ],
      "question": {
        "type": "choice",
        "instructions": "这次故障的首要原因是哪一类（expired_credential、clock_skew）？只按这次读到的材料归因；证据不足时按 other 的判据作答。",
        "criteria": {
          "expired_credential": "服务端证书已过期（notAfter 早于当前时间），系统时钟与权威时钟一致",
          "clock_skew": "本机系统时钟偏差超窗（证书本身仍在有效期内）",
          "other": "未列入候选集的原因：**读到的记录里没有任何一条**能把上面的候选区分开时（含关键证据尚未取得）必须选 other；判据是「需要的那份证据不在这次读到的材料里」，不要从候选集里挑一个最像的标签"
        }
      }
    },
    {
      "id": "b_pair_cause_p2",
      "version": 1,
      "reads": [
        "app.log"
      ],
      "question": {
        "type": "choice",
        "instructions": "这次故障的首要原因是哪一类（upstream_throttle、retry_storm）？只按这次读到的材料归因；证据不足时按 other 的判据作答。",
        "criteria": {
          "upstream_throttle": "上游主动限流（返回 429 / Retry-After），客户端重试次数很少",
          "retry_storm": "客户端重试策略失控（窗口内重试次数远超上限），上游本身正常",
          "other": "未列入候选集的原因：**读到的记录里没有任何一条**能把上面的候选区分开时（含关键证据尚未取得）必须选 other；判据是「需要的那份证据不在这次读到的材料里」，不要从候选集里挑一个最像的标签"
        }
      }
    },
    {
      "id": "b_pair_cause_p3",
      "version": 1,
      "reads": [
        "app.log"
      ],
      "question": {
        "type": "choice",
        "instructions": "这次故障的首要原因是哪一类（authority_missing、network_partition）？只按这次读到的材料归因；证据不足时按 other 的判据作答。",
        "criteria": {
          "authority_missing": "权威记录缺失（权威可达但应答 NXDOMAIN）",
          "network_partition": "到权威的链路中断（探测丢包 100%）",
          "other": "未列入候选集的原因：**读到的记录里没有任何一条**能把上面的候选区分开时（含关键证据尚未取得）必须选 other；判据是「需要的那份证据不在这次读到的材料里」，不要从候选集里挑一个最像的标签"
        }
      }
    }
  ],
  "pairs": [
    {
      "id": "P1",
      "title": "证书过期 vs 时钟偏差",
      "question": "b_pair_cause_p1",
