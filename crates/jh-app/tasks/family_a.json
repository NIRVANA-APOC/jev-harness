        {
          "source": "tool:read_metrics",
          "at_unix_ms": 1700000000200,
          "object": "runtime.metrics",
          "version": 1,
          "content": {
            "p99_ms": 118,
            "saturation": 0.31,
            "note": "指标正常"
          }
        },
        {
          "source": "tool:read_notes",
          "at_unix_ms": 1700000000300,
          "object": "unrelated-notes.md",
          "version": 1,
          "content": { "note": "与本次故障无关的排期记录：下周容量评审" }
        }
      ],
      "tracked": [
        { "question": "cause_primary", "due_round": 0 },
        { "question": "premise_holds", "due_round": 0 },
        { "question": "deliverable_ready", "due_round": 2 }
      ],
      "extra_dependencies": [],
      "steps": [
        {
          "round": 1,
          "when": "before_ask",
          "note": "注入推翻前提的新证据：确认取消后仍有写入且写入已生效",
          "change": {
            "kind": "append",
